{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["chain_id","address","symbol","identity_confirmed","category","facts","audits","incidents","signals","confidence","summary","sources","as_of"],
  "properties": {
    "chain_id": {"type": "integer"},
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "symbol": {"type": "string", "maxLength": 40},
    "identity_confirmed": {"type": "boolean"},
    "category": {"enum": ["native-crypto","wrapped-crypto","liquid-staking","liquid-restaking","fiat-stablecoin","crypto-backed-stablecoin","synthetic-stablecoin","yield-bearing-stablecoin","rwa-treasury","rwa-credit","tokenized-equity","pendle-pt","vault-or-lp-share","governance-or-alt","other"]},
    "facts": {"type": "object", "additionalProperties": false,
      "required": ["issuer","underlying","backing","redemption","price_oracle","admin_controls","liquidity","regulatory"],
      "properties": {
        "issuer": {"$ref": "#/$defs/fact"}, "underlying": {"$ref": "#/$defs/fact"}, "backing": {"$ref": "#/$defs/fact"},
        "redemption": {"$ref": "#/$defs/fact"}, "price_oracle": {"$ref": "#/$defs/fact"}, "admin_controls": {"$ref": "#/$defs/fact"},
        "liquidity": {"$ref": "#/$defs/fact"}, "regulatory": {"$ref": "#/$defs/fact"}}},
    "audits": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false,
      "required": ["auditor","date","source_ids"],
      "properties": {"auditor": {"type": "string", "maxLength": 80}, "date": {"type": ["string","null"]}, "source_ids": {"$ref": "#/$defs/ids"}}}},
    "incidents": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false,
      "required": ["date","type","summary","resolved","source_ids"],
      "properties": {"date": {"type": ["string","null"]}, "type": {"enum": ["depeg","exploit","redemption_halt","regulatory_action","other"]},
        "summary": {"type": "string", "maxLength": 300}, "resolved": {"type": ["boolean","null"]}, "source_ids": {"$ref": "#/$defs/ids"}}}},
    "signals": {"type": "object", "additionalProperties": false,
      "required": ["can_freeze_or_blacklist","can_mint_without_limit","upgradeable_proxy","has_timelock","admin_multisig","redemption_gated","kyc_required","custodial_backing","backing_attested","independently_audited","has_unresolved_incident","oracle_is_market_price"],
      "properties": {
        "can_freeze_or_blacklist": {"$ref": "#/$defs/signal"}, "can_mint_without_limit": {"$ref": "#/$defs/signal"}, "upgradeable_proxy": {"$ref": "#/$defs/signal"},
        "has_timelock": {"$ref": "#/$defs/signal"}, "admin_multisig": {"$ref": "#/$defs/signal"}, "redemption_gated": {"$ref": "#/$defs/signal"},
        "kyc_required": {"$ref": "#/$defs/signal"}, "custodial_backing": {"$ref": "#/$defs/signal"}, "backing_attested": {"$ref": "#/$defs/signal"},
        "independently_audited": {"$ref": "#/$defs/signal"}, "has_unresolved_incident": {"$ref": "#/$defs/signal"}, "oracle_is_market_price": {"$ref": "#/$defs/signal"}}},
    "confidence": {"enum": ["low","medium","high"]},
    "summary": {"type": "string", "maxLength": 400},
    "sources": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false,
      "required": ["id","url","title","published","accessed"],
      "properties": {"id": {"type": "integer", "minimum": 1}, "url": {"type": "string", "maxLength": 500, "pattern": "^https://"},
        "title": {"type": "string", "maxLength": 200}, "published": {"type": ["string","null"]}, "accessed": {"type": "string"}}}},
    "as_of": {"type": "string"}
  },
  "$defs": {
    "ids": {"type": "array", "maxItems": 6, "items": {"type": "integer", "minimum": 1}},
    "signal": {"type": "object", "additionalProperties": false, "required": ["value","source_ids"],
      "properties": {"value": {"type": ["boolean","null"]}, "source_ids": {"$ref": "#/$defs/ids"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["value","source_ids"],
      "properties": {"value": {"type": ["string","null"], "maxLength": 400}, "source_ids": {"$ref": "#/$defs/ids"}}}
  }
}
